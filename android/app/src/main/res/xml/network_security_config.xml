<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config untuk Depot Air Minum GNR.
  HTTPS-only, cleartext traffic diblokir untuk semua domain.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
