# Better Auth
BETTER_AUTH_SECRET=ganti-dengan-random-string-panjang-min-32-char
BETTER_AUTH_URL=http://localhost:3000

# Database (file SQLite)
DATABASE_URL=./data/depot.db

# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# WhatsApp
# provider: fonnte | wablas | wweb
WHATSAPP_PROVIDER=fonnte
WHATSAPP_API_KEY=
WHATSAPP_API_URL=https://api.fonnte.com/send

# Google Sheets (lewat Apps Script — set di /admin/pengaturan, bukan di sini)

# Google Maps (opsional, fallback otomatis ke OpenStreetMap kalau kosong / gagal load)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
